# Copy to .env and fill in. Never commit the real .env.
# From https://discord.com/developers/applications :

# Bot tab -> Reset Token -> copy. Keep this SECRET.
DISCORD_TOKEN=

# General Information tab -> Application ID.
CLIENT_ID=

# Optional: a test server's ID. If set, `npm run deploy` registers slash
# commands to that server instantly (global registration takes up to ~1h).
# GUILD_ID=

# Optional: timezone that decides when the daily answer rolls over. All
# players share it so the leaderboard stays consistent. Default: UTC.
# GLOBLE_TZ=UTC

# Optional: where to persist game state. The Docker image already sets this
# to /data/state.json (a mounted volume); only override for a custom path.
# STATE_FILE=/data/state.json
