# Copy to .env and fill in. Never commit the real .env.
# All values come from https://discord.com/developers/applications

# Bot tab -> Reset Token -> copy. Keep this SECRET.
DISCORD_TOKEN=

# General Information tab -> Application ID. Public: it is baked into the
# activity's client bundle, which every player's Discord downloads.
CLIENT_ID=

# OAuth2 tab -> Client Secret -> Reset Secret. Keep this SECRET. The activity's
# server needs it to exchange each player's authorization code for a token.
CLIENT_SECRET=

# Optional: a test server's ID. If set, `npm run deploy` registers the slash
# commands to that server instantly instead of globally, which takes up to an
# hour. The Activity launcher entry is always global and is skipped when this
# is set.
# GUILD_ID=

# Optional: port the activity server listens on. The container sets 3000.
# PORT=3000

# Optional: timezone that decides when the daily answer rolls over. All
# players share it so the leaderboard stays consistent. Default: UTC.
# GLOBLE_TZ=UTC

# Optional: where to persist game state. The Docker image already sets this
# to /data/state.json (a mounted volume); only override for a custom path.
# STATE_FILE=/data/state.json

# Development only.

# Hand out a session to anyone who asks, so the activity opens in a plain
# browser without Discord. Such a session gets no channel and cannot announce.
# Refused when NODE_ENV is production, which the Docker image sets.
# DEV_LOGIN=1

# Add a Reset button to the activity that erases today's daily and lets it be
# played again, for testing the win, the announcement and the result card more
# than once a day. Shift-clicking it clears the day for every player.
#
# This one does work in the image, because an announcement can only be tested
# from inside Discord. That also means everyone in the channel can wipe the day
# while it is set, so unset it and recreate the container when finished.
# DEV_RESET=1
